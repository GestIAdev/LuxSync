{
  "$schema": "luxsync.lfx/3.0",

  "clip": {
    "id": "efecto_base",
    "name": "Efecto Base — Plantilla V3",
    "author": "LuxSync Factory",
    "category": "composite",

    "tags": ["template", "techno"],
    "vibeCompat": ["techno"],

    "durationMs": 1600,
    "effectType": "heph_custom",

    "authoringMemory": {
      "antiBugChecklist": [
        "REGLA 1: Si hay color o strobeRate en PARs, declarar SIEMPRE un track intensity para esas zonas.",
        "REGLA 2: strobeRate abre shutter, pero no levanta dimmer: sin intensity explícita, la salida visual es negro.",
        "REGLA 3: Para intensity usar blendMode=max (HTP). Para color usar blendMode=replace (LTP).",
        "REGLA 4: Para MAXIMIZAR un impacto Strobe, incluye SIEMPRE un track con intensity=0 y blendMode=replace en 'all-movers' (Blackout táctico).",
        "REGLA 5 (VIBES): vibeCompat SOLO puede contener 'techno' o 'latin'. Prohibido inventar géneros.",
        "REGLA 6 (ENERGÍA): energyZone min/max DEBEN ser escalones de The Ladder: silence, valley, ambient, gentle, active, intense, peak.",
        "REGLA 7 (DIVINE ARSENAL): Si isDivineCandidate=true, ENTONCES cooldownMs > 15000, fatigueImpact > 0.8 y zScoreGuards.minimumZ >= 4.0."
      ]
    },

    "tracks": [
      {
        "id": "base-intensity",
        "paramId": "intensity",
        "zones": ["all-pars"],
        "blendMode": "max",
        "curve": {
          "paramId": "intensity",
          "valueType": "number",
          "defaultValue": 0,
          "keyframes": [
            { "timeMs": 0,    "value": 1.0, "interpolation": "hold" },
            { "timeMs": 400,  "value": 0,   "interpolation": "hold" },
            { "timeMs": 800,  "value": 1.0, "interpolation": "hold" },
            { "timeMs": 1200, "value": 0,   "interpolation": "hold" }
          ]
        }
      },
      {
        "id": "base-color",
        "paramId": "color",
        "zones": ["all-pars"],
        "blendMode": "replace",
        "curve": {
          "paramId": "color",
          "valueType": "color",
          "defaultValue": { "h": 220, "s": 100, "l": 50 },
          "keyframes": [
            { "timeMs": 0, "value": { "h": 220, "s": 100, "l": 50 }, "interpolation": "hold" }
          ]
        }
      }
    ],

    "cognitiveDNA": {
      "genome": { "aggression": 0.6, "chaos": 0.4, "organicity": 0.2 },
      "textureAffinity": "clean",
      "compatibleVibes": ["techno"],
      "validSections": ["drop"],
      "energyZone": { "min": "intense", "max": "peak" },
      "aggressionRange": { "min": 0.4, "max": 0.8 },
      "spatialBehavior": "static"
    },

    "simulationMeta": {
      "beautyWeights": { "base": 0.6, "energyMultiplier": 1.0, "vibeBonus": 0.0 },
      "gpuCost": 0.1,
      "fatigueImpact": 0.2,
      "minDurationMs": 1600,
      "cooldownMs": 3000,
      "isStrobe": false,
      "isDivineCandidate": false,
      "isHeavyCandidate": false,
      "zScoreGuards": { "requireRising": false, "minimumZ": null, "minimumEnergy": null }
    }
  }
}
