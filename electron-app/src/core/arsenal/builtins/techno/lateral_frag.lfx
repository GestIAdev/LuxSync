{
  "$schema": "luxsync.lfx/3.0",
  "clip": {
    "id": "lateral_frag",
    "name": "Lateral Frag",
    "author": "LuxSync Factory",
    "category": "physical",
    "tags": ["strobe", "lateral", "techno", "phase", "drop", "fragmented"],
    "vibeCompat": ["techno"],
    "durationMs": 1200,
    "effectType": "heph_custom",
    "cognitiveDNA": {
      "genome": { "aggression": 0.92, "chaos": 0.85, "organicity": 0.05 },
      "textureAffinity": "dirty",
      "compatibleVibes": ["techno"],
      "validSections": ["drop", "peak"],
      "energyZone": { "min": "intense", "max": "peak" },
      "aggressionRange": { "min": 0.7, "max": 1.0 },
      "spatialBehavior": "dynamic"
    },
    "simulationMeta": {
      "beautyWeights": { "base": 0.88, "energyMultiplier": 1.1, "vibeBonus": 0.1 },
      "gpuCost": 0.3,
      "fatigueImpact": 0.55,
      "minDurationMs": 1200,
      "cooldownMs": 3000,
      "isStrobe": true,
      "isDivineCandidate": false,
      "isHeavyCandidate": true,
      "zScoreGuards": { "requireRising": false, "minimumZ": 1.5, "minimumEnergy": 0.85 }
    },
    "tracks": [
      {
        "id": "strobe-front-phase0",
        "paramId": "strobeRate",
        "zones": ["front"],
        "curve": {
          "paramId": "strobeRate",
          "valueType": "number",
          "defaultValue": 0,
          "keyframes": [
            { "timeMs": 0,    "value": 1.0, "interpolation": "hold" },
            { "timeMs": 150,  "value": 0,   "interpolation": "hold" },
            { "timeMs": 300,  "value": 1.0, "interpolation": "hold" },
            { "timeMs": 450,  "value": 0,   "interpolation": "hold" },
            { "timeMs": 600,  "value": 1.0, "interpolation": "hold" },
            { "timeMs": 750,  "value": 0,   "interpolation": "hold" },
            { "timeMs": 900,  "value": 1.0, "interpolation": "hold" },
            { "timeMs": 1050, "value": 0,   "interpolation": "hold" }
          ]
        }
      },
      {
        "id": "strobe-back-phase150",
        "paramId": "strobeRate",
        "zones": ["back"],
        "curve": {
          "paramId": "strobeRate",
          "valueType": "number",
          "defaultValue": 0,
          "keyframes": [
            { "timeMs": 0,    "value": 0,   "interpolation": "hold" },
            { "timeMs": 150,  "value": 1.0, "interpolation": "hold" },
            { "timeMs": 300,  "value": 0,   "interpolation": "hold" },
            { "timeMs": 450,  "value": 1.0, "interpolation": "hold" },
            { "timeMs": 600,  "value": 0,   "interpolation": "hold" },
            { "timeMs": 750,  "value": 1.0, "interpolation": "hold" },
            { "timeMs": 900,  "value": 0,   "interpolation": "hold" },
            { "timeMs": 1050, "value": 1.0, "interpolation": "hold" },
            { "timeMs": 1200, "value": 0,   "interpolation": "hold" }
          ]
        }
      },
      {
        "id": "color-front-orange",
        "paramId": "color",
        "zones": ["front"],
        "curve": {
          "paramId": "color",
          "valueType": "color",
          "defaultValue": { "h": 25, "s": 100, "l": 55 },
          "keyframes": [
            { "timeMs": 0, "value": { "h": 25, "s": 100, "l": 55 }, "interpolation": "hold" }
          ]
        }
      },
      {
        "id": "color-back-yellow",
        "paramId": "color",
        "zones": ["back"],
        "curve": {
          "paramId": "color",
          "valueType": "color",
          "defaultValue": { "h": 52, "s": 100, "l": 55 },
          "keyframes": [
            { "timeMs": 0, "value": { "h": 52, "s": 100, "l": 55 }, "interpolation": "hold" }
          ]
        }
      },
      {
        "id": "intensity-front",
        "paramId": "intensity",
        "zones": ["front"],
        "blendMode": "max",
        "curve": {
          "paramId": "intensity",
          "valueType": "number",
          "defaultValue": 1.0,
          "keyframes": [
            { "timeMs": 0, "value": 1.0, "interpolation": "hold" }
          ]
        }
      },
      {
        "id": "intensity-back",
        "paramId": "intensity",
        "zones": ["back"],
        "blendMode": "max",
        "curve": {
          "paramId": "intensity",
          "valueType": "number",
          "defaultValue": 1.0,
          "keyframes": [
            { "timeMs": 0, "value": 1.0, "interpolation": "hold" }
          ]
        }
      },
      {
        "id": "movers-blackout",
        "paramId": "intensity",
        "zones": ["all-movers"],
        "blendMode": "replace",
        "curve": {
          "paramId": "intensity",
          "valueType": "number",
          "defaultValue": 0,
          "keyframes": [
            { "timeMs": 0, "value": 0, "interpolation": "hold" }
          ]
        }
      }
    ]
  }
}
