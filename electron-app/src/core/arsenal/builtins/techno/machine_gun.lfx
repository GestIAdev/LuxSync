{
  "$schema": "luxsync.lfx/3.0",
  "clip": {
    "id": "machine_gun",
    "name": "Machine Gun",
    "author": "LuxSync Factory",
    "category": "physical",
    "tags": ["strobe", "techno", "brutal", "drop", "maxrate"],
    "vibeCompat": ["techno"],
    "durationMs": 800,
    "effectType": "heph_custom",
    "cognitiveDNA": {
      "genome": { "aggression": 1.0, "chaos": 0.9, "organicity": 0.0 },
      "textureAffinity": "dirty",
      "compatibleVibes": ["techno"],
      "validSections": ["drop", "peak"],
      "energyZone": { "min": "intense", "max": "peak" },
      "aggressionRange": { "min": 0.85, "max": 1.0 },
      "spatialBehavior": "static"
    },
    "simulationMeta": {
      "beautyWeights": { "base": 0.9, "energyMultiplier": 1.3, "vibeBonus": 0.1 },
      "gpuCost": 0.3,
      "fatigueImpact": 0.65,
      "minDurationMs": 800,
      "cooldownMs": 3500,
      "isStrobe": true,
      "isDivineCandidate": false,
      "isHeavyCandidate": true,
      "zScoreGuards": { "requireRising": true, "minimumZ": 2, "minimumEnergy": 0.92 }
    },
    "tracks": [
      {
        "id": "par-strobe-max",
        "paramId": "strobeRate",
        "zones": ["all-pars"],
        "curve": {
          "paramId": "strobeRate",
          "valueType": "number",
          "defaultValue": 0,
          "keyframes": [
            { "timeMs": 0,   "value": 1.0, "interpolation": "hold" },
            { "timeMs": 800, "value": 0,   "interpolation": "hold" }
          ]
        }
      },
      {
        "id": "par-white",
        "paramId": "color",
        "zones": ["all-pars"],
        "curve": {
          "paramId": "color",
          "valueType": "color",
          "defaultValue": { "h": 0, "s": 0, "l": 100 },
          "keyframes": [
            { "timeMs": 0, "value": { "h": 0, "s": 0, "l": 100 }, "interpolation": "hold" }
          ]
        }
      },
      {
        "id": "par-intensity",
        "paramId": "intensity",
        "zones": ["all-pars"],
        "blendMode": "max",
        "curve": {
          "paramId": "intensity",
          "valueType": "number",
          "defaultValue": 1.0,
          "keyframes": [
            { "timeMs": 0, "value": 1.0, "interpolation": "hold" }
          ]
        }
      },
      {
        "id": "movers-blackout",
        "paramId": "intensity",
        "zones": ["all-movers"],
        "blendMode": "replace",
        "curve": {
          "paramId": "intensity",
          "valueType": "number",
          "defaultValue": 0,
          "keyframes": [
            { "timeMs": 0, "value": 0, "interpolation": "hold" }
          ]
        }
      }
    ]
  }
}
