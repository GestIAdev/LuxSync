{
  "$schema": "luxsync.lfx/3.0",
  "clip": {
    "id": "strobe_ping_pong",
    "name": "Strobe Ping Pong",
    "author": "LuxSync Factory",
    "category": "physical",
    "tags": ["strobe", "techno", "ping-pong", "spatial"],
    "vibeCompat": ["techno", "hardstyle"],
    "durationMs": 400,
    "effectType": "heph_custom",
    "cognitiveDNA": {
      "genome": { "aggression": 0.9, "chaos": 0.8, "organicity": 0.1 },
      "textureAffinity": "dirty",
      "compatibleVibes": ["techno", "hardstyle"],
      "validSections": ["drop", "peak"],
      "energyZone": { "min": "intense", "max": "peak" },
      "aggressionRange": { "min": 0.5, "max": 1.0 },
      "spatialBehavior": "dynamic"
    },
    "simulationMeta": {
      "beautyWeights": { "base": 0.8, "energyMultiplier": 1.0, "vibeBonus": 0.1 },
      "gpuCost": 0.2,
      "fatigueImpact": 0.3,
      "minDurationMs": 400,
      "cooldownMs": 2000,
      "isStrobe": true,
      "isDivineCandidate": false,
      "isHeavyCandidate": true,
      "zScoreGuards": { "requireRising": false, "minimumZ": 1, "minimumEnergy": 0.7 }
    },
    "tracks": [
      {
        "id": "ping-left",
        "paramId": "strobeRate",
        "zones": ["movers-left"],
        "curve": {
          "paramId": "strobeRate",
          "valueType": "number",
          "defaultValue": 0,
          "keyframes": [
            { "timeMs": 0, "value": 1, "interpolation": "hold" },
            { "timeMs": 200, "value": 0, "interpolation": "hold" }
          ]
        }
      },
      {
        "id": "pong-right",
        "paramId": "strobeRate",
        "zones": ["movers-right"],
        "curve": {
          "paramId": "strobeRate",
          "valueType": "number",
          "defaultValue": 0,
          "keyframes": [
            { "timeMs": 200, "value": 1, "interpolation": "hold" },
            { "timeMs": 400, "value": 0, "interpolation": "hold" }
          ]
        }
      },
      {
        "id": "blackout-movers",
        "paramId": "intensity",
        "zones": ["all-movers"],
        "blendMode": "replace",
        "curve": {
          "paramId": "intensity",
          "valueType": "number",
          "defaultValue": 0,
          "keyframes": [
            { "timeMs": 0, "value": 0, "interpolation": "hold" }
          ]
        }
      }
    ]
  }
}